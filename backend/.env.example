# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: Gemini model name (default: gemini-3.5-flash-lite)
# MODEL=gemini-3.5-flash-lite

# Optional: comma-separated list of allowed frontend origins (default: *)
CORS_ORIGINS=http://localhost:5173
